{
    "name": "setechsolutions/php-whois",
    "description": "Drop-in replacement for io-developer/php-whois: parsed and raw domain lookups over RDAP with WHOIS fallback, plus ASN routes. PHP 7.2+ compatible",
    "keywords": [
        "php",
        "whois",
        "rdap",
        "query",
        "tld",
        "domain",
        "lookup",
        "info",
        "asn",
        "routes",
        "parser"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/SETechSolutions/php-whois",
    "authors": [
        {
            "name": "Sergey Sedyshev",
            "email": "i.o.developer@gmail.com",
            "homepage": "https://github.com/io-developer",
            "role": "Original author"
        },
        {
            "name": "SETechSolutions",
            "homepage": "https://github.com/SETechSolutions",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=7.2",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "symfony/polyfill-intl-idn": "^1.27"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5 || ^9.6"
    },
    "replace": {
        "io-developer/php-whois": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Iodev\\": "src/Iodev/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "": [ "tests/" ]
        }
    },
    "scripts": {
        "test": [
            "phpunit"
        ],
        "test-live": [
            "phpunit --group live"
        ]
    }
}
