{
    "name": "setechsolutions/php-whois",
    "description": "Domain lookups over RDAP with WHOIS fallback, for plain PHP and Laravel 6 to 13: registrar, dates, name servers, availability",
    "keywords": [
        "php",
        "laravel",
        "whois",
        "rdap",
        "domain",
        "lookup",
        "tld",
        "availability",
        "expiration",
        "parser"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/SETechSolutions/php-whois",
    "authors": [
        {
            "name": "SETechSolutions",
            "homepage": "https://github.com/SETechSolutions",
            "role": "Maintainer"
        },
        {
            "name": "Sergey Sedyshev",
            "email": "i.o.developer@gmail.com",
            "homepage": "https://github.com/io-developer",
            "role": "Author of the WHOIS parsers, from io-developer/php-whois"
        }
    ],
    "require": {
        "php": ">=7.2.5",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "symfony/polyfill-intl-idn": "^1.27"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5 || ^9.6 || ^10.5 || ^11.5 || ^12.0 || ^13.0"
    },
    "conflict": {
        "laravel/framework": "<6.0"
    },
    "autoload": {
        "psr-4": {
            "SETechSolutions\\Whois\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SETechSolutions\\Whois\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SETechSolutions\\Whois\\Laravel\\WhoisServiceProvider"
            ],
            "aliases": {
                "Whois": "SETechSolutions\\Whois\\Laravel\\Facades\\Whois"
            }
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test-laravel": "phpunit --testsuite laravel",
        "test-live": "phpunit --testsuite live"
    }
}
