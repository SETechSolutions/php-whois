<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true" defaultTestSuite="unit">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Needs orchestra/testbench for the Laravel version under test -->
        <testsuite name="laravel">
            <directory>tests/Laravel</directory>
        </testsuite>
        <!-- Queries real RDAP and WHOIS servers -->
        <testsuite name="live">
            <directory>tests/Live</directory>
        </testsuite>
    </testsuites>
</phpunit>
