<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true">
    <testsuites>
        <testsuite name="php-whois">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!-- Queries real RDAP and WHOIS servers: composer test-live -->
            <group>live</group>
        </exclude>
    </groups>
</phpunit>
